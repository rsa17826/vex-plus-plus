CREATE  TABLE public.level test 2 (
  id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  "levelData" text NOT NULL,
  "creatorId" uuid NOT NULL,
  "levelName" text NOT NULL DEFAULT ''::text,
  "gameVersion" bigint NOT NULL,
  "creatorName" text NOT NULL,
  "levelVersion" numeric NOT NULL,
  description text NOT NULL,
  "levelImage" text NOT NULL,
  CONSTRAINT level test 2_pkey PRIMARY KEY (id),
  CONSTRAINT level test 2_gameVersion_check CHECK (("gameVersion" >= 1)),
  CONSTRAINT level test 2_levelImage_check CHECK ((length("levelImage") > 50))
) TABLESPACE pg_default;
CREATE TRIGGER whitespace_replacement_trigger BEFORE INSERT OR UPDATE ON "level test 2" FOR EACH ROW EXECUTE FUNCTION replace_whitespace();